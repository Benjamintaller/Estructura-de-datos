import tkinter as tk
from tkinter import messagebox


class CambistaApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Cambista PRO")
        self.root.geometry("480x540")
        self.root.config(bg="#0f172a")  # fondo oscuro elegante
        self.root.resizable(False, False)

        self.crear_ui()

    def crear_ui(self):
        # ===== TÍTULO =====
        tk.Label(
            self.root,
            text="💱 Cambista PRO",
            font=("Segoe UI", 18, "bold"),
            fg="white",
            bg="#0f172a"
        ).pack(pady=15)

        # ===== CONTENEDOR =====
        card = tk.Frame(self.root, bg="#111827", bd=0)
        card.pack(padx=15, pady=10, fill="both")

        # ===== ENTRADAS =====
        self.entry_monto = self.crear_input(card, "Monto")
        self.entry_compra = self.crear_input(card, "Compra USDT (Bs)")
        self.entry_venta = self.crear_input(card, "Venta USDT (S/)")
        self.entry_comision = self.crear_input(card, "Comisión (%)", "1.5")

        # ===== BOTONES =====
        btn_frame = tk.Frame(card, bg="#111827")
        btn_frame.pack(pady=15)

        self.crear_boton(btn_frame, "Bs → Soles", "#22c55e", lambda: self.convertir("bs")).grid(row=0, column=0, padx=5)
        self.crear_boton(btn_frame, "Soles → Bs", "#3b82f6", lambda: self.convertir("soles")).grid(row=0, column=1, padx=5)

        # ===== RESULTADO =====
        self.resultado = tk.StringVar()
        self.resultado.set("Aquí verás el resultado")

        tk.Label(
            self.root,
            textvariable=self.resultado,
            font=("Consolas", 11),
            bg="#0f172a",
            fg="#38bdf8",
            justify="left"
        ).pack(pady=20)

    def crear_input(self, parent, texto, default=""):
        frame = tk.Frame(parent, bg="#111827")
        frame.pack(pady=6, fill="x")

        tk.Label(
            frame,
            text=texto,
            fg="#9ca3af",
            bg="#111827",
            anchor="w"
        ).pack(fill="x")

        entry = tk.Entry(
            frame,
            bg="#1f2937",
            fg="white",
            insertbackground="white",
            relief="flat",
            font=("Segoe UI", 11)
        )
        entry.pack(fill="x", ipady=6)

        if default:
            entry.insert(0, default)

        return entry

    def crear_boton(self, parent, texto, color, comando):
        return tk.Button(
            parent,
            text=texto,
            bg=color,
            fg="white",
            activebackground=color,
            relief="flat",
            font=("Segoe UI", 10, "bold"),
            width=18,
            command=comando
        )

    def obtener_valores(self):
        try:
            monto = float(self.entry_monto.get())
            compra = float(self.entry_compra.get())
            venta = float(self.entry_venta.get())
            comision = float(self.entry_comision.get()) / 100

            if monto <= 0 or compra <= 0 or venta <= 0:
                raise ValueError

            return monto, compra, venta, comision

        except:
            messagebox.showerror("Error", "Datos inválidos")
            return None

    def convertir(self, tipo):
        datos = self.obtener_valores()
        if not datos:
            return

        monto, compra, venta, comision = datos

        if tipo == "bs":
            usdt = monto / compra
            fee = usdt * comision
            usdt_neto = usdt - fee
            soles = usdt_neto * venta

            self.resultado.set(
                f"╔═══ Bs → Soles ═══╗\n"
                f"Monto: Bs {monto:.2f}\n"
                f"USDT: {usdt:.4f}\n"
                f"Comisión: -{fee:.4f}\n"
                f"USDT neto: {usdt_neto:.4f}\n"
                f"----------------------\n"
                f"Recibes: S/ {soles:.2f}"
            )

        else:
            usdt = monto / venta
            fee = usdt * comision
            usdt_total = usdt + fee
            bolivianos = usdt_total * compra

            self.resultado.set(
                f"╔═══ Soles → Bs ═══╗\n"
                f"Monto: S/ {monto:.2f}\n"
                f"USDT: {usdt:.4f}\n"
                f"Comisión: +{fee:.4f}\n"
                f"USDT total: {usdt_total:.4f}\n"
                f"----------------------\n"
                f"Pagas: Bs {bolivianos:.2f}"
            )


# ===== EJECUTAR =====
root = tk.Tk()
app = CambistaApp(root)
root.mainloop()
